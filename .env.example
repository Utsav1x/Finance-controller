# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.example .env.local
#
# Restart the dev server after any change; Next.js reads these at boot and will
# not hot-reload them.


# ── AI provider ───────────────────────────────────────────────────────────────
# Free, no credit card: https://aistudio.google.com → Get API key → Create API key
#
# Used ONLY for tier-4 adjudication of records the deterministic tiers could not
# resolve, and for the settlement Q&A agent.
#
# Leaving this blank is a supported mode, not a broken one: tiers 0–3 still run,
# and every record the LLM would have judged lands on the exception list with
# reason code LLM_UNAVAILABLE. The match rate drops; nothing is silently dropped.
GOOGLE_AI_API_KEY=

# Optional. The model tried first for adjudication.
#
# Free-tier quota is granted per model per day and is small — some models allow
# only 20 requests/day. When one is exhausted the provider falls through a chain
# of alternatives automatically, so this is a preference, not a hard dependency.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Which provider implements the AIProvider interface. Only 'gemini'
# exists today, which is the default — set this only when adding another.
# AI_PROVIDER=gemini


# ── Engine ────────────────────────────────────────────────────────────────────
# Minimum confidence a tier-4 (LLM) verdict must clear to be recorded as a match.
# Anything below it becomes an exception instead. Raising this trades match rate
# for precision; the scorecard shows you exactly what the trade cost.
LLM_CONFIDENCE_FLOOR=0.75

# Hard cap on tier-4 calls per run, so a bad dataset cannot burn a day's quota.
LLM_MAX_CALLS_PER_RUN=40
